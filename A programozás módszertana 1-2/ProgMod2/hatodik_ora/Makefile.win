# Project: Project1
# Makefile created by Dev-C++ 4.9.9.2

CPP  = g++.exe
CC   = gcc.exe
WINDRES = windres.exe
RES  = 
OBJ  = main.o muv.o $(RES)
LINKOBJ  = main.o muv.o $(RES)
LIBS =  -L"C:/Users/Administrator/Dev-Cpp/lib"  
INCS =  -I"C:/Users/Administrator/Dev-Cpp/include" 
CXXINCS =  -I"C:/Users/Administrator/Dev-Cpp/lib/gcc/mingw32/3.4.2/include"  -I"C:/Users/Administrator/Dev-Cpp/include/c++/3.4.2/backward"  -I"C:/Users/Administrator/Dev-Cpp/include/c++/3.4.2/mingw32"  -I"C:/Users/Administrator/Dev-Cpp/include/c++/3.4.2"  -I"C:/Users/Administrator/Dev-Cpp/include" 
BIN  = projekt.exe
CXXFLAGS = $(CXXINCS)  
CFLAGS = $(INCS)  
RM = rm -f

.PHONY: all all-before all-after clean clean-custom

all: all-before projekt.exe all-after


clean: clean-custom
	${RM} $(OBJ) $(BIN)

$(BIN): $(OBJ)
	$(CPP) $(LINKOBJ) -o "projekt.exe" $(LIBS)

main.o: main.cpp
	$(CPP) -c main.cpp -o main.o $(CXXFLAGS)

muv.o: muv.cpp
	$(CPP) -c muv.cpp -o muv.o $(CXXFLAGS)
