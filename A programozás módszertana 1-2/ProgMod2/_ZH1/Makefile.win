LIBS =  -L"C:/Users/Administrator/Dev-Cpp/lib"  
INCS =  -I"C:/Users/Administrator/Dev-Cpp/include" 
CXXINCS =  -I"C:/Users/Administrator/Dev-Cpp/lib/gcc/mingw32/3.4.2/include"  -I"C:/Users/Administrator/Dev-Cpp/include/c++/3.4.2/backward"  -I"C:/Users/Administrator/Dev-Cpp/include/c++/3.4.2/mingw32"  -I"C:/Users/Administrator/Dev-Cpp/include/c++/3.4.2"  -I"C:/Users/Administrator/Dev-Cpp/include" 
BIN  = ZH.exe
